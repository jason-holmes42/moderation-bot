<UserControl x:Class="WPFClient.ProviderView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="#FF2D2D30"/>
        </Style>

        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="2"/>
                </Style>
            </Style.Resources>
        </Style>
    </UserControl.Resources>
    
    <Border BorderBrush="DarkViolet" BorderThickness="1" Unloaded="ProviderView_Unloaded">
        <DockPanel>
            <!-- Title Bar -->
            <Grid DockPanel.Dock="Top"
                  Height="28"
                  Background="#FF2D2D30"
                  x:Name="TitleBar"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  MouseMove="TitleBar_MouseMove"
                  MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">

                <TextBlock VerticalAlignment="Center"
                           Margin="8,0"
                           Foreground="White">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} | {1}">
                            <Binding Path="ProviderName"/>
                            <Binding Path="UserIdentity"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <Button HorizontalAlignment="Right" Margin="2" Width="25" Height="25" Content="✕" Click="btnClose"/>
            </Grid>
            
            <!-- Chat Input -->
            <Grid DockPanel.Dock="Bottom" Height="25" VerticalAlignment="Bottom" Background="DimGray">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="75"/>
                </Grid.ColumnDefinitions>

                <TextBox Name="txtChatInput" 
                         Grid.Column="0" 
                         Padding="2" 
                         Foreground="Gray" 
                         GotFocus="ChatInput_GotFocus" 
                         LostFocus="ChatInput_LostFocus"
                         KeyDown="ChatInput_KeyDown"
                         Loaded="ChatInput_Loaded"/>

                <Button Grid.Column="1"
                        Content="{Binding [SendButton], Source={x:Static local:LocalizationManager.Instance}, TargetNullValue='Send'}"
                        Click="ChatInput_Send"/>
            </Grid>

            <!-- Main Content -->
            <!-- DARK gray background, white text. Wraps and dictates the size of the "line" for both sections. Each line has some padding above and below-->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Name="sclMessages">
                <Grid Background="#FF18181B">
                    <Grid.ColumnDefinitions>
                        <!-- Column 30% for bot reactions-->
                        <ColumnDefinition Width="3*" />
                        <!-- Some alternation (GridSplitter) from the main window to visually separate. Messages should be in-line with their triggering message. -->
                        <ColumnDefinition Width="4" />
                        <!-- Column 70% for incoming messages-->
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>

                    <GridSplitter Grid.Column="1"
                              Background="#FF2D2D30"
                              HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              IsEnabled="False"/>

                    <ItemsControl ItemsSource="{Binding MessageItems}"
                              Grid.Column="0"
                              Grid.ColumnSpan="3">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="7*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Bot Reactions -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding BotReaction}"
                                               TextWrapping="Wrap"
                                               Foreground="White"
                                               Margin="4,0"/>

                                    <GridSplitter Grid.Column="1"
                                                  Background="#FF2D2D30"
                                                  HorizontalAlignment="Stretch"
                                                  ResizeBehavior="PreviousAndNext"
                                                  IsEnabled="False"/>

                                    <!-- Chat Messages -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ChatMessage}"
                                               TextWrapping="Wrap"
                                               Foreground="White"
                                               Margin="4,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>