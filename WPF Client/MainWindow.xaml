<Window x:Class="WPFClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:commands="clr-namespace:WPFClient.Commands"
        mc:Ignorable="d"
        Title="Chat Moderation Bot" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen">
    <Window.CommandBindings>
        <CommandBinding Command="commands:CustomCommands.Exit" CanExecute="ExitCommand_CanExecute" Executed="ExitCommand_Executed" />
        <CommandBinding Command="commands:CustomCommands.NewProvider" Executed="OnNewProviderExecuted" />
    </Window.CommandBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Margin="5" Background="White">
            <MenuItem Header="_File" MinWidth="40">
                <MenuItem Command="commands:CustomCommands.NewProvider" CommandTarget="{Binding NewProviderCommand}"/>
                <Separator />
                <MenuItem Command="commands:CustomCommands.Exit"/>
            </MenuItem>
        </Menu>
        
        <Border Background="Bisque" BorderThickness="0,1,0,0" BorderBrush="Goldenrod"> 
            <ItemsControl ItemsSource="{Binding ProviderViews}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>                
            </ItemsControl>
        </Border>
        
    </DockPanel>
</Window>
