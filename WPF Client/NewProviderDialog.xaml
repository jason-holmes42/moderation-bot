<Window x:Class="WPFClient.NewProviderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient"
        xmlns:providers="clr-namespace:ChatModerationBot.Core.Providers;assembly=ChatModerationBot"
        mc:Ignorable="d"
        Title="{Binding [NewProviderDialog], Source={x:Static local:LocalizationManager.Instance}, TargetNullValue='Start New Provider'}"
        SizeToContent="WidthAndHeight"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        
        <Style x:Key="ProviderRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ProviderCardBorder"
                                Background="Gainsboro"  
                                BorderBrush="Gray" 
                                Width="225" 
                                BorderThickness="1" 
                                Margin="5">

                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Disabled (show as grayed out when disabled) -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ProviderCardBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>

                            <!-- Selected -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ProviderCardBorder" Property="BorderBrush" Value="DodgerBlue"/>
                                <Setter TargetName="ProviderCardBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="10" Background="GhostWhite">
        <StackPanel Orientation="Horizontal" Margin="5" >
            <StackPanel.Resources>
                <Style TargetType="StackPanel">
                    <Setter Property="Margin" Value="10"/>
                </Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,5,0,0"/>
                </Style>
            </StackPanel.Resources>

            <RadioButton GroupName="Providers"
                             Style="{StaticResource ProviderRadioButtonStyle}" 
                             Tag="{x:Static providers:ProviderID.ChatReplay}"
                             Checked="Provider_Checked">
                <StackPanel>
                    <DockPanel VerticalAlignment="Center">
                        <Image Source="Images/twitch_glitch_VOD.png" Height="40" Width="40" Margin="0,0,5,0"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="14" TextAlignment="Center" Margin="0"
                                   Text="{Binding [TwitchVODTitle], Source={x:Static local:LocalizationManager.Instance}, TargetNullValue='Twitch\nVOD Chat Replay'}">
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Text="{Binding [TwitchVODDesc], Source={x:Static local:LocalizationManager.Instance}, TargetNullValue='Replay a Twitch VOD chat log'}" 
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                    <Label Content="{Binding [TwitchVODDensity], Source={x:Static local:LocalizationManager.Instance}, TargetNullValue='Choose a chat density:'}" Margin="-5,10,0,0"/>
                    <RadioButton Name="rdSlow" GroupName="chatReplayDensity" Checked="Options_Checked" Content="{Binding [TwitchVODDensityLow], Source={x:Static local:LocalizationManager.Instance}, TargetNullValue='Low'}" Tag="low_density_log.json"/>
                    <RadioButton Name="rdMedium" GroupName="chatReplayDensity" Checked="Options_Checked" Content="{Binding [TwitchVODDensityMedium], Source={x:Static local:LocalizationManager.Instance}, TargetNullValue='Medium'}" Tag="medium_density_log.json"/>
                    <RadioButton Name="rdFast" GroupName="chatReplayDensity" Checked="Options_Checked" Content="{Binding [TwitchVODDensityHigh], Source={x:Static local:LocalizationManager.Instance}, TargetNullValue='High'}" Tag="high_density_log.json"/>
                </StackPanel>
            </RadioButton>

            <RadioButton GroupName="Providers" 
                             Style="{StaticResource ProviderRadioButtonStyle}" 
                             Tag="x:Static providers:ProviderID.Twitch"
                             Checked="Provider_Checked"
                             IsEnabled="False">
                <StackPanel>
                    <DockPanel VerticalAlignment="Center">
                        <Image Source="Images/twitch_glitch.png" Height="40" Width="40" Margin="0,0,5,0"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="14" TextAlignment="Center" Margin="0"
                                   Text="{Binding [TwitchTitle], Source={x:Static local:LocalizationManager.Instance}, TargetNullValue='Twitch'}">
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Text="{Binding [TwitchDesc], Source={x:Static local:LocalizationManager.Instance}, TargetNullValue='Connect to a live Twitch stream chat.'}" 
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </RadioButton>

            <RadioButton GroupName="Providers" 
                             Style="{StaticResource ProviderRadioButtonStyle}" 
                             Tag="x:Static providers:ProviderID.Youtube"
                             Checked="Provider_Checked"
                             IsEnabled="False">
                <StackPanel>
                    <DockPanel VerticalAlignment="Center">
                        <Image Source="Images/youtube_icon.png" Height="40" Width="40" Margin="0,0,5,0"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="14" TextAlignment="Center" Margin="0"
                                   Text="{Binding [YoutubeTitle], Source={x:Static local:LocalizationManager.Instance}, TargetNullValue='YouTube'}">
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Text="{Binding [YoutubeDesc], Source={x:Static local:LocalizationManager.Instance}, TargetNullValue='Connect to a live YouTube chat.'}" 
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </RadioButton>

            <RadioButton GroupName="Providers"
                             Style="{StaticResource ProviderRadioButtonStyle}" 
                             Tag="x:Static providers:ProviderID.NicoNico"
                             Checked="Provider_Checked"
                             IsEnabled="False">
                <StackPanel>
                    <DockPanel VerticalAlignment="Center">
                        <Image Source="Images/niconicoterebichan.png" Height="40" Width="40" Margin="0,0,5,0"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="14" TextAlignment="Center" Margin="0"
                                   Text="{Binding [NiconicoTitle], Source={x:Static local:LocalizationManager.Instance}, TargetNullValue='ニコニコ'}">
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Text="{Binding [NiconicoDesc], Source={x:Static local:LocalizationManager.Instance}, TargetNullValue='Connect to a live Niconico chat.'}" 
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </RadioButton>

        </StackPanel>

        <Label Content="{Binding [PlatformIdentityLabel], Source={x:Static local:LocalizationManager.Instance}, TargetNullValue='Platform Identity'}" Margin="0,0,0,-2"/>
        <TextBox Name="txtIdentity" Padding="2" Margin="5,0,0,0" Foreground="Gray" GotFocus="Identity_GotFocus" LostFocus="Identity_LostFocus" Loaded="Identity_Loaded"/>

        <WrapPanel HorizontalAlignment="Right" Margin="10,5,0,0">
            <Button Name="btnOK" Click="btnDialogOK_Click" IsDefault="True" Content="{Binding [OKButton], Source={x:Static local:LocalizationManager.Instance}, TargetNullValue='OK'}"/>
            <Button Name="btnCancel" IsCancel="True" Margin="10,5,0,5" Content="{Binding [CancelButton], Source={x:Static local:LocalizationManager.Instance}, TargetNullValue='Cancel'}"/>
        </WrapPanel>
    </StackPanel>
</Window>
