<Window x:Class="WPFClient.NewProviderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient"
        xmlns:providers="clr-namespace:ChatModerationBot.Core.Providers;assembly=BotCore"
        mc:Ignorable="d"
        Title="Start Provider"
        SizeToContent="WidthAndHeight"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        
        <Style x:Key="ProviderRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ProviderCardBorder"
                                Background="Gainsboro"  
                                BorderBrush="Gray" 
                                Width="225" 
                                BorderThickness="1" 
                                Margin="5">

                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Disabled (show as grayed out when disabled) -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ProviderCardBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>

                            <!-- Selected -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ProviderCardBorder" Property="BorderBrush" Value="DodgerBlue"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="10" Background="GhostWhite">
        <StackPanel Orientation="Horizontal" Margin="5" >
            <StackPanel.Resources>
                <Style TargetType="StackPanel">
                    <Setter Property="Margin" Value="10"/>
                </Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,5,0,0"/>
                </Style>
            </StackPanel.Resources>

            <RadioButton GroupName="Providers"
                             Style="{StaticResource ProviderRadioButtonStyle}" 
                             Tag="{x:Static providers:ProviderID.ChatReplay}"
                             Checked="Provider_Checked">
                <StackPanel>
                    <DockPanel VerticalAlignment="Center">
                        <Image Source="Images/twitch_glitch_VOD.png" Height="40" Width="40" Margin="0,0,5,0"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="14" TextAlignment="Center" Margin="0">
                            Twitch <LineBreak/> VOD Chat Replay
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Text="Replay a Twitch VOD chat log" />
                    <Label Content="Choose the chat density:" Margin="-5,10,0,0"/>
                    <RadioButton Name="rdSlow" GroupName="chatReplayDensity" Checked="Options_Checked" Content="Slow" Tag="low_density_log.json"/>
                    <RadioButton Name="rdMedium" GroupName="chatReplayDensity" Checked="Options_Checked" Content="Medium" Tag="medium_density_log.json"/>
                    <RadioButton Name="rdFast" GroupName="chatReplayDensity" Checked="Options_Checked" Content="Fast" Tag="high_density_log.json"/>
                </StackPanel>
            </RadioButton>

            <RadioButton GroupName="Providers" 
                             Style="{StaticResource ProviderRadioButtonStyle}" 
                             Tag="x:Static providers:ProviderID.Twitch"
                             Checked="Provider_Checked"
                             IsEnabled="False">
                <StackPanel>
                    <DockPanel VerticalAlignment="Center">
                        <Image Source="Images/twitch_glitch.png" Height="40" Width="40" Margin="0,0,5,0"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="18" Text="Twitch" />
                    </DockPanel>
                    <TextBlock Text="Connect to a live Twitch chat" />
                </StackPanel>
            </RadioButton>

            <RadioButton GroupName="Providers" 
                             Style="{StaticResource ProviderRadioButtonStyle}" 
                             Tag="x:Static providers:ProviderID.Youtube"
                             Checked="Provider_Checked"
                             IsEnabled="False">
                <StackPanel>
                    <DockPanel VerticalAlignment="Center">
                        <Image Source="Images/youtube_icon.png" Height="40" Width="40" Margin="0,0,5,0"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="18" Text="YouTube" />
                    </DockPanel>
                    <TextBlock Text="Connect to a live YouTube chat" />
                </StackPanel>
            </RadioButton>

            <RadioButton GroupName="Providers"
                             Style="{StaticResource ProviderRadioButtonStyle}" 
                             Tag="x:Static providers:ProviderID.NicoNico"
                             Checked="Provider_Checked"
                             IsEnabled="False">
                <StackPanel>
                    <DockPanel VerticalAlignment="Center">
                        <Image Source="Images/niconicoterebichan.png" Height="40" Width="40" Margin="0,0,5,0"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="18" Text="ニコニコ" />
                    </DockPanel>
                    <TextBlock Text="Connect to a live Nico Nico chat" />
                </StackPanel>
            </RadioButton>

        </StackPanel>

        <Label Content="Platform Identity" Margin="0,0,0,-2"/>
        <TextBox Name="txtIdentity" Padding="2" Margin="5,0,0,0" Foreground="Gray" GotFocus="Identity_GotFocus" LostFocus="Identity_LostFocus">
            Enter your identity on the chosen platform...
        </TextBox>
        <WrapPanel HorizontalAlignment="Right" Margin="10,5,0,0">
            <Button Name="btnOK" Click="btnDialogOK_Click" IsDefault="True">OK</Button>
            <Button Name="btnCancel" IsCancel="True" Margin="10,5,0,5">Cancel</Button>
        </WrapPanel>
    </StackPanel>
</Window>
